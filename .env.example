# Copy to .env. Never commit .env.

# Postgres (docker compose maps 5433 → 5432)
DATABASE_URL=postgres://brio:brio@localhost:5433/brio
# Server-level URL used by tests to create throwaway databases
TEST_DATABASE_URL=postgres://brio:brio@localhost:5433/postgres

# URLs
APP_URL=http://localhost:3000
API_URL=http://localhost:4000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000

# Auth (Better Auth). Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Optional: Google sign-in
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Local development: GET /v1/dev/outbox shows emails "sent" locally (magic links, invitations). Never in production.
BRIO_DEV_OUTBOX=true

# Email (M9): with a Resend key, magic links, invitations and notifications are sent by Resend; without one they go to
# the dev outbox. BRIO_EMAIL_FROM must be on a domain verified in Resend.
RESEND_API_KEY=
BRIO_EMAIL_FROM="Brio <onboarding@resend.dev>"

# Web push (M9): generate with `npx web-push generate-vapid-keys`. Without them browser notifications are off.
BRIO_VAPID_PUBLIC_KEY=
BRIO_VAPID_PRIVATE_KEY=
BRIO_VAPID_SUBJECT=mailto:admin@example.com

# Slack (M9): each workspace connects its own Slack app in Settings (bot scopes chat:write and users:read.email;
# interactivity request URL <APP_URL>/v1/integrations/slack/interactions). Only the API base is configured here.
# BRIO_SLACK_API_URL=https://slack.com/api

# Scale (M10, D-99): "all" runs everything in one API process; at scale run "web" processes (as many as you like) and
# exactly one "worker". Postgres connections per API process; proxies in front whose X-Forwarded-For is believed;
# requests per client address per minute (0: no limit).
# BRIO_API_ROLE=all
# DATABASE_POOL_MAX=20
# BRIO_TRUST_PROXY_HOPS=1
# BRIO_RATE_LIMIT_PER_MINUTE=1200

# Billing hook (M10, D-105), for operators who charge for hosting Brio: daily usage per workspace, signed.
# BRIO_BILLING_WEBHOOK_URL=
# BRIO_BILLING_WEBHOOK_SECRET=

# Vault: local key-encryption key (32 bytes, base64). Generate with: openssl rand -base64 32
# For AWS KMS set BRIO_KMS_PROVIDER=aws and BRIO_AWS_KMS_KEY_ID instead.
BRIO_KMS_PROVIDER=local
BRIO_VAULT_LOCAL_KEK=
BRIO_AWS_KMS_KEY_ID=

# Connectors. Private-network base URLs (local models, your own proxy) are allowed outside production by default.
# Cloud metadata addresses are always blocked.
# BRIO_ALLOW_PRIVATE_URLS=true
# Hours between live price refreshes (OpenRouter's public list); 0 turns it off.
BRIO_PRICING_REFRESH_HOURS=24
# USD per unit for vendors that price in other currencies (Sarvam bills in INR). Without a rate those prices are unknown.
# BRIO_FX_USD_PER=INR=0.0114

# Runner (apps/runner): where worktrees and repository caches live, and how many attempts run at once.
# Sandbox images are built from apps/runner/images on first use; pin pushed images with BRIO_IMAGE_BASE/CLI/PROXY.
# BRIO_RUNNER_DIR=~/.brio/runner
BRIO_RUNNER_CONCURRENCY=2
# Projects may point at local repository paths (self-hosting, local development). Defaults to on outside production.
# BRIO_ALLOW_LOCAL_REPOS=true
# GitHub's REST API for pull requests and issue links (GitHub Enterprise Server: https://<host>/api/v3).
# BRIO_GITHUB_API_URL=https://api.github.com
# Port of the runner's mailbox server, reached by sandboxes through their proxy (0 picks a free port).
# BRIO_RUNNER_MAILBOX_PORT=0
