{
  "name": "@brio/brand",
  "version": "0.1.0",
  "private": true,
  "description": "Brio brand: tokens, Tailwind presets, logo files and brand strings. The only place colours are defined.",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./tokens.css": "./tokens.css",
    "./shadcn.css": "./shadcn.css",
    "./tailwind.preset": "./tailwind.preset.ts",
    "./shadcn.preset": "./shadcn.preset.ts",
