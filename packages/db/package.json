{
  "name": "@brio/db",
  "version": "0.0.0",
  "private": true,
  "description": "Drizzle schema, migrations and query helpers",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema/index.ts",
    "./testing": "./src/testing.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:check": "drizzle-kit check",
    "db:migrate": "tsx src/scripts/migrate.ts",
    "db:seed": "tsx src/scripts/seed.ts",
    "db:reset": "tsx src/scripts/reset.ts"
  },
  "dependencies": {
    "@brio/schema": "workspace:*",
    "drizzle-orm": "0.45.4",
    "pg": "8.23.1",
    "uuidv7": "1.2.1"
  },
  "devDependencies": {
    "@types/pg": "^8.15.0",
    "drizzle-kit": "0.31.11",
    "tsx": "4.23.15"
  }
}
