{
  "name": "@brio/api",
  "version": "0.0.0",
  "private": true,
  "description": "Fastify API: REST, SSE, MCP and A2A servers; hosts the orchestrator loop",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/main.ts",
    "start": "tsx src/main.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:live": "vitest run --config vitest.live.config.ts"
  },
  "dependencies": {
    "@a2a-js/sdk": "1.3.0",
    "@better-auth/cimd": "1.7.12",
    "@better-auth/mcp": "1.7.12",
    "@better-auth/oauth-provider": "1.7.12",
    "@better-auth/passkey": "1.7.12",
    "@brio/adapters": "workspace:*",
    "@brio/core": "workspace:*",
    "@brio/db": "workspace:*",
    "@brio/governance": "workspace:*",
    "@brio/registry": "workspace:*",
    "@brio/runner": "workspace:*",
    "@brio/schema": "workspace:*",
    "@brio/vault": "workspace:*",
    "@fastify/cors": "11.3.1",
    "@modelcontextprotocol/sdk": "1.32.1",
    "better-auth": "1.7.12",
    "drizzle-orm": "0.45.4",
    "fastify": "5.12.7",
    "jose": "6.2.13",
    "pg": "8.23.1",
    "pg-boss": "12.38.0",
    "uuidv7": "1.2.1",
    "web-push": "3.6.7",
    "ws": "8.22.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@brio/cli": "workspace:*",
    "@types/pg": "^8.23.1",
    "@types/web-push": "3.6.4",
    "@types/ws": "8.18.1",
    "tsx": "4.23.15"
  }
}
