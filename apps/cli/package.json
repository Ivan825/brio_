{
  "name": "@brio/cli",
  "version": "0.1.0",
  "private": true,
  "description": "The brio CLI",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
