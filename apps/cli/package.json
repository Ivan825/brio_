  },
  "dependencies": {
    "@brio/runner": "workspace:*",
    "@modelcontextprotocol/sdk": "1.32.1",
    "tsx": "4.23.15"
  },
  "devDependencies": {
    "esbuild": "0.28.2"
  }
}
