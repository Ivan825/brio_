{
  "name": "@brio/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "sync-brand": "node scripts/sync-brand-assets.mjs",
    "dev": "pnpm sync-brand && next dev --port 3000",
    "build": "pnpm sync-brand && next build",
    "start": "next start --port 3000",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run --passWithNoTests",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@better-auth/oauth-provider": "1.7.12",
    "@better-auth/passkey": "1.7.12",
    "@brio/brand": "workspace:*",
    "@brio/schema": "workspace:*",
    "better-auth": "1.7.12",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "geist": "1.8.2",
    "lucide-react": "1.61.0",
    "marked": "18.1.0",
    "next": "16.4.2",
    "next-themes": "0.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "tailwind-merge": "2.6.1"
  },
  "devDependencies": {
    "@brio/db": "workspace:*",
    "@playwright/test": "1.64.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "autoprefixer": "10.6.1",
    "drizzle-orm": "0.45.4",
    "postcss": "8.5.31",
    "tailwindcss": "3.4.19"
  }
}
